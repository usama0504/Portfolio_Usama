includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 5

    reportUnmatchedIgnoredErrors: false # <--- Yeh line add kar dein

    ignoreErrors:
        - '#Access to an undefined property Illuminate\\Database\\Eloquent\\Model::\$id#'
        - '#Access to an undefined property Illuminate\\Database\\Eloquent\\Model::\$body#'
        - '#Access to an undefined property Illuminate\\Database\\Eloquent\\Model::\$created_at#'
        - '#Match expression does not handle remaining value#'
        - '~Parameter #1 \$callback of method Illuminate\\Database\\Eloquent\\Collection.*contains unresolvable type~'